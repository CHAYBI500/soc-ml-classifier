# Copie ce fichier en ".env" (à la racine du projet) puis remplis les valeurs réelles.
# Le ".env" n'est jamais commité (voir .gitignore) : c'est là que vont les secrets.
# Chargé automatiquement au démarrage de l'API (src/api.py -> load_dotenv()).

# ---------------------------------------------------------------------------
# Gemini (assistant IA du dashboard, endpoint /ai/ask)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Délai max (ms) accordé à chaque appel Gemini avant échec. Sans cette limite, un appel
# bloqué par une coupure réseau/DNS transitoire (même flakiness que celle documentée pour
# SMTP, voir SMTP_SEND_ATTEMPTS plus bas) ferait rester /ai/ask pendu indéfiniment côté
# dashboard au lieu d'échouer proprement et de laisser le retry (voir src/api.py::ai_ask)
# prendre le relais. Le SDK google-genai impose un plancher de 10s (en dessous : 400
# INVALID_ARGUMENT "Manually set deadline is too short"). Défaut : 12000 (12s).
GEMINI_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# SQL Server surveillé (endpoints /sql/*) — VM Windows Server 2019 / SQL Server 2016
# ---------------------------------------------------------------------------

# Hôte ou IP du SQL Server (ex: 172.17.1.115). Obligatoire pour activer /sql/*.
SQLSRV_HOST=

# Port TCP (défaut si absent : 1433)
SQLSRV_PORT=1433

# Base de connexion initiale (défaut si absent : master)
SQLSRV_DATABASE=master

# "yes" pour utiliser l'authentification Windows intégrée (le compte qui lance uvicorn
# doit alors avoir un accès SQL). Sinon "no" (défaut) pour utiliser SQLSRV_USER/PASSWORD
# ci-dessous, ce qui est recommandé ici puisque l'API tourne sur un poste distinct de la VM SQL.
SQLSRV_TRUSTED_CONNECTION=no

# Login SQL dédié, en LECTURE SEULE (voir le script de création plus bas).
# Ne jamais utiliser un compte sysadmin/sa ici.
SQLSRV_USER=soc_monitor
SQLSRV_PASSWORD=

# Nom du driver ODBC installé sur la machine qui exécute l'API (voir prérequis dans le README).
# Défaut si absent : "ODBC Driver 17 for SQL Server"
SQLSRV_DRIVER=ODBC Driver 17 for SQL Server

# Nom EXACT de l'agent Wazuh installé sur la VM SQL Server (visible dans Wazuh > Agents).
# Sert à filtrer /sql/security-events. Si laissé vide, filtrage par sous-chaîne "sql" dans agent_name.
SQLSRV_WAZUH_AGENT_NAME=

# ---------------------------------------------------------------------------
# API REST du manager Wazuh (onglet dashboard "Hygiène IT" — /hygiene/*)
# ---------------------------------------------------------------------------
# Différent du webhook /predict (qui REÇOIT les alertes) : ici l'API interroge le manager
# Wazuh pour lire l'inventaire syscollector (logiciels, ports, processus, correctifs).

# Hôte ou IP du manager Wazuh (ex: 10.212.2.170). Obligatoire pour activer /hygiene/*.
WAZUH_API_HOST=

# Port de l'API REST Wazuh (défaut si absent : 55000)
WAZUH_API_PORT=55000

# Utilisateur API Wazuh dédié en LECTURE SEULE (voir README section 13 pour la création
# via RBAC — permissions "agent:read" + "syscollector:read" uniquement).
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# "yes" si le manager a un certificat TLS valide sur l'API REST, "no" (défaut) s'il utilise
# le certificat auto-signé par défaut de Wazuh (cas le plus courant en interne).
WAZUH_API_VERIFY_SSL=no

# ---------------------------------------------------------------------------
# Authentification admin du dashboard (voir src/auth.py, section README "14. Authentification admin")
# ---------------------------------------------------------------------------

# Clé d'installation à fournir pour créer un nouveau compte admin (POST /auth/register).
# OBLIGATOIRE pour activer l'inscription : sans elle, /auth/register renvoie 503.
# Génère une valeur forte et ne la partage qu'avec les personnes autorisées à créer
# un compte admin (ex: openssl rand -hex 24).
ADMIN_SETUP_KEY=

# Durée de vie d'une session admin après connexion (heures). Défaut : 8.
ADMIN_SESSION_TTL_HOURS=8

# "yes" pour marquer le cookie de session "Secure" (à réserver à un déploiement servi
# en HTTPS). "no" (défaut) pour du HTTP simple, ex: réseau interne sans TLS.
ADMIN_COOKIE_SECURE=no

# Origines autorisées en cross-origin (CORS), séparées par des virgules. Laisser vide
# (défaut) : le dashboard étant servi en même origine que l'API, aucune origine
# cross-origin n'est nécessaire. N'affecte PAS n8n / l'intégration Wazuh (appels
# serveur-à-serveur, non soumis à CORS qui ne concerne que les navigateurs).
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# SMTP (envoi des codes de vérification email / OTP de connexion admin)
# ---------------------------------------------------------------------------
# Si SMTP_HOST est vide, aucun email n'est réellement envoyé : le code est seulement
# loggé côté serveur (pratique en dev, DANGEREUX à laisser ainsi en production —
# un avertissement est affiché au démarrage de l'API tant que ce n'est pas configuré).

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse expéditrice affichée (défaut si absent : SMTP_USER)
SMTP_FROM=
# "yes" (défaut) pour STARTTLS, "no" pour connexion en clair (relai SMTP interne de confiance uniquement)
SMTP_USE_TLS=yes

# Résilience aux pannes réseau/DNS transitoires côté serveur SMTP (ex: [Errno 11001]
# getaddrinfo failed) — utile quand le réseau/firewall est géré par l'IT et n'est pas
# modifiable directement. Backoff exponentiel : délai = min(SMTP_RETRY_BASE_DELAY *
# 2^(tentative-1), SMTP_RETRY_MAX_DELAY). Défauts : 9 tentatives, 3s -> 30s max
# (fenêtre totale ~165s : 3+6+12+24+30+30+30+30). À remonter encore si les pannes
# observées durent plus longtemps ; attention toutefois à un éventuel timeout d'un
# proxy/firewall intermédiaire sur une requête HTTP synchrone trop longue.
SMTP_SEND_ATTEMPTS=9
SMTP_RETRY_BASE_DELAY=3.0
SMTP_RETRY_MAX_DELAY=30.0

# IP de secours du serveur SMTP (voir SMTP_HOST ci-dessus), utilisée UNIQUEMENT si la
# résolution DNS échoue ET qu'aucune IP n'a encore été résolue avec succès depuis le
# démarrage du process (cas d'un process qui redémarre pendant une panne DNS déjà en
# cours, ex: uvicorn --reload — sinon le process apprend et met en cache la bonne IP
# dès le premier envoi réussi, sans avoir besoin de ce réglage).
# Optionnel : laisser vide désactive ce secours (comportement précédent, échec DNS non
# rattrapé tant qu'aucun envoi n'a réussi). Pour obtenir l'IP actuelle depuis un poste
# où la résolution DNS fonctionne : `nslookup mail.groupeaddoha.ma`. Cette IP peut
# changer si l'IT migre le relai mail — à revalider périodiquement.
SMTP_HOST_FALLBACK_IP=
